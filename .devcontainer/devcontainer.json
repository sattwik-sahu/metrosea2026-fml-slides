{
  "name": "MetroSea slides (LaTeX)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Open the slides/ folder itself in VS Code so main.tex is the workspace root.
  "customizations": {
    "vscode": {
      "extensions": [
        "James-Yu.latex-workshop"
      ],
      "settings": {
        // Build with plain latexmk and let the repo's .latexmkrc pick the
        // engine (LuaLaTeX) and options. NOTE: no -pdf/-pdflatex flag here,
        // because those would override .latexmkrc and force pdfLaTeX, which
        // cannot compile this project (fontspec + unicode-math need LuaLaTeX).
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk (repo .latexmkrc)",
            "command": "latexmk",
            "args": [
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=%OUTDIR%",
              "%DOC%"
            ]
          }
        ],
        "latex-workshop.latex.recipes": [
          {
            "name": "latexmk",
            "tools": [
              "latexmk (repo .latexmkrc)"
            ]
          }
        ],
        // Matches $out_dir in .latexmkrc: PDF + aux files land in build/.
        "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
        // Rebuild on every save: this is the "live preview" behaviour.
        "latex-workshop.latex.autoBuild.run": "onSave",
        // Show the PDF in a VS Code tab next to the editor, with SyncTeX
        // (Ctrl+click jumps between source and PDF).
        "latex-workshop.view.pdf.viewer": "tab",
        "latex-workshop.synctex.afterBuild.enabled": true
      }
    }
  },
  "shutdownAction": "stopContainer"
}
